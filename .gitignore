# .gitignore for CodeIgniter project

# OS
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# PHP / Composer
/vendor/
composer.lock
composer.phar
.env
.env.*

# Node
node_modules/
npm-debug.log*
yarn-error.log

# Logs and databases
*.log
*.sql
*.sqlite
*.sqlite3

# Uploads, cache, temp
uploads/
application/cache/
application/logs/
cache/
tmp/
*.tmp

# Build
dist/
build/

# XAMPP/Windows
xampp/tmp/
# PHP general
vendor/
composer.lock
.env
*.log
*.cache
*.sql

# XAMPP and server-generated
uploads/
application/cache/
application/logs/
application/session/
asset/uploads/

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.iml

# Node and build files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
